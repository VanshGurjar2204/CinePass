        {
          "name": "Get Interactive Seat Map & Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.seats) {",
                  "        var avail = json.data.seats.filter(function(s) { return s.status === 'available'; });",
                  "        if (avail.length >= 2) {",
                  "            pm.environment.set('seatId1', avail[0]._id);",
                  "            pm.environment.set('seatId2', avail[1]._id);",
                  "            console.log('Selected Available Seats:', avail[0].seatLabel, avail[1].seatLabel);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shows/{{showId}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows",
                "{{showId}}",
                "seats"
              ]
            }
          }
        }
